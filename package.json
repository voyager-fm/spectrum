{
  "name": "spectrum",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter @spectrum/web dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:migrate": "pnpm --filter @spectrum/web db:migrate",
    "cli": "node apps/cli/src/index.ts",
    "spec:check": "node apps/cli/src/index.ts check",
    "spec:list": "node apps/cli/src/index.ts list",
    "test": "node --test \"{apps,packages}/*/src/**/*.test.ts\" && pnpm test:documents && pnpm test:tables && pnpm test:links",
    "test:e2e": "pnpm --filter @spectrum/web test:e2e",
    "test:e2e:ui": "pnpm --filter @spectrum/web test:e2e:ui",
    "test:documents": "node scripts/test-document-snapshot.ts && node scripts/test-document-parsing.ts && node scripts/test-document-edits.ts",
    "test:tables": "node scripts/test-table-validation.ts",
    "test:links": "node scripts/test-specification-links.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @spectrum/web typecheck",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm spec:check && pnpm plugin:check",
    "agents:setup": "apm install --frozen && apm audit --ci",
    "agents:sync": "apm install && apm audit --ci",
    "plugin:build": "pnpm --filter @spectrum/plugin build",
    "plugin:check": "pnpm --filter @spectrum/plugin check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
