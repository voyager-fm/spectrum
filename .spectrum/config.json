{
  "$schema": "https://raw.githubusercontent.com/voyager-fm/spectrum/main/packages/spec-engine/schemas/config.schema.json",
  "schema_version": 2,
  "name": "Spectrum",
  "mode": "proposal-only",
  "canonical_source": "git-files",
  "overview": ".spectrum/overview.md",
  "inventories": [
    {
      "catalog": ".spectrum/product/feature_inventory/schema.json"
    }
  ],
  "documents": [
    {
      "kind": "feature_bundle",
      "root": ".spectrum/product/feature_inventory/specs"
    },
    {
      "kind": "surface_bundle",
      "root": ".spectrum/product/feature_inventory/surfaces"
    },
    {
      "kind": "contracts",
      "root": ".spectrum/contracts"
    },
    {
      "kind": "flows",
      "root": ".spectrum/flows"
    },
    {
      "kind": "engineering",
      "root": ".spectrum/engineering"
    },
    {
      "kind": "rules",
      "root": ".spectrum/rules"
    }
  ]
}
