{
  "$schema": "./schemas/config.schema.json",
  "schema_version": 2,
  "name": "Spectrum",
  "mode": "proposal-only",
  "canonical_source": "git-files",
  "overview": ".spectrum/overview.md",
  "inventories": [
    {
      "kind": "objects",
      "data": ".spectrum/product/information_architecture/objects/data.tsv",
      "schema": ".spectrum/product/information_architecture/objects/schema.json"
    },
    {
      "kind": "surfaces",
      "data": ".spectrum/product/information_architecture/surfaces/data.tsv",
      "schema": ".spectrum/product/information_architecture/surfaces/schema.json"
    },
    {
      "kind": "regions",
      "data": ".spectrum/product/information_architecture/surface_structure/data.tsv",
      "schema": ".spectrum/product/information_architecture/surface_structure/schema.json"
    },
    {
      "kind": "categories",
      "data": ".spectrum/product/feature_inventory/feature_categories/data.tsv",
      "schema": ".spectrum/product/feature_inventory/feature_categories/schema.json"
    },
    {
      "kind": "features",
      "data": ".spectrum/product/feature_inventory/features/data.tsv",
      "schema": ".spectrum/product/feature_inventory/features/schema.json"
    },
    {
      "kind": "interactions",
      "data": ".spectrum/product/feature_inventory/interactions/data.tsv",
      "schema": ".spectrum/product/feature_inventory/interactions/schema.json"
    },
    {
      "kind": "routes",
      "data": ".spectrum/product/website/route_map/routes/data.tsv",
      "schema": ".spectrum/product/website/route_map/routes/schema.json"
    }
  ],
  "documents": [
    {
      "kind": "feature_bundle",
      "root": ".spectrum/product/feature_specs"
    },
    {
      "kind": "page_bundle",
      "root": ".spectrum/product/website/page_contracts"
    },
    {
      "kind": "contracts",
      "root": ".spectrum/contracts"
    },
    {
      "kind": "flows",
      "root": ".spectrum/flows"
    },
    {
      "kind": "engineering",
      "root": ".spectrum/engineering"
    },
    {
      "kind": "rules",
      "root": ".spectrum/rules"
    },
    {
      "kind": "reference",
      "root": ".spectrum/product/specification_structure.md"
    }
  ],
  "integrations": {
    "github": {
      "enabled": false
    },
    "linear": {
      "enabled": false
    }
  },
  "agents": {
    "enabled": false,
    "max_repair_attempts": 2
  }
}
