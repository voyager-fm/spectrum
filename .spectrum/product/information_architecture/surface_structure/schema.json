{
  "$schema": "../../../schemas/inventory.schema.json",
  "schema_version": "1.0",
  "name": "SURFACE_STRUCTURE",
  "primary_key": ["structure_key"],
  "null_values": ["-"],
  "columns": [
    {
      "name": "surface_key",
      "type": "string",
      "required": true,
      "ref": {
        "table": "SURFACES",
        "column": "surface_key"
      }
    },
    {
      "name": "parent_region_id",
      "type": "string",
      "required": false,
      "ref": {
        "table": "SURFACE_STRUCTURE",
        "columns": ["surface_key", "parent_region_id"],
        "references": ["surface_key", "region_id"]
      }
    },
    {
      "name": "region_id",
      "type": "string",
      "required": true
    },
    {
      "name": "region_label",
      "type": "string",
      "required": true
    },
    {
      "name": "level",
      "type": "number",
      "required": false
    },
    {
      "name": "slot_type",
      "type": "string",
      "required": false,
      "enum": ["root", "pane", "section", "overlay", "mode"]
    },
    {
      "name": "structure_key",
      "type": "string",
      "required": true
    },
    {
      "name": "description",
      "type": "string",
      "required": false
    },
    {
      "name": "interaction_refs",
      "type": "string",
      "required": false,
      "ref": {
        "table": "INTERACTIONS",
        "column": "interaction_id"
      }
    },
    {
      "name": "status",
      "type": "string",
      "required": false,
      "enum": ["idea", "drafted", "planned", "implementing", "shipped", "deprecated"]
    }
  ]
}
