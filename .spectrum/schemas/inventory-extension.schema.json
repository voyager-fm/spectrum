{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TSV inventory schema extension",
  "description": "Adds repository columns to an engine-owned FI table schema. List every TSV column in header order: base columns by name only, added columns with a full definition. The base owns name, primary_key, null_values and base column rules.",
  "type": "object",
  "required": ["schema_version", "extends", "columns"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "extends": {
      "enum": ["spectrum:feature_categories", "spectrum:features", "spectrum:interactions"]
    },
    "description": {
      "type": "string"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "$ref": "inventory.schema.json#/properties/columns/items"
          }
        ]
      }
    }
  },
  "not": {
    "anyOf": [
      {
        "required": ["name"]
      },
      {
        "required": ["primary_key"]
      },
      {
        "required": ["null_values"]
      }
    ]
  }
}
