{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spectrum document model draft 0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1-draft"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      },
      "uniqueItems": true
    },
    "surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      },
      "uniqueItems": true
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      },
      "uniqueItems": true
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      },
      "uniqueItems": true
    },
    "interactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interaction"
      },
      "uniqueItems": true
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      },
      "uniqueItems": true
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      },
      "uniqueItems": true
    },
    "specs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spec"
      },
      "uniqueItems": true
    },
    "external_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/external_link"
      },
      "uniqueItems": true
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "name",
    "objects",
    "surfaces",
    "categories",
    "features",
    "interactions",
    "contracts",
    "flows",
    "specs",
    "external_links",
    "open_questions"
  ],
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": ["draft", "in_review", "approved", "changes_requested"]
        },
        "approval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "actor_id": {
                  "type": "string",
                  "minLength": 1
                },
                "approved_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": ["actor_id", "approved_at", "content_sha256"]
            }
          ]
        }
      },
      "required": ["state", "approval"],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "approval": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "approval": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": ["now", "next", "later", "undecided"]
        },
        "implementation": {
          "enum": ["unverified", "planned", "in_progress", "implemented", "released"]
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      },
      "required": ["phase", "implementation", "review"]
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^obj-[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": ["id", "title", "description", "states"]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^surface-[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["web", "cli", "api", "background", "desktop", "other"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "title", "kind", "description"]
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cat-[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "title", "description"]
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^feat-[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category_id": {
          "type": "string",
          "pattern": "^cat-[a-z][a-z0-9_-]*$"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^obj-[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "surface_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^surface-[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        }
      },
      "required": ["id", "title", "category_id", "intent", "object_ids", "surface_ids", "lifecycle"]
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^int-[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "feature_id": {
          "type": "string",
          "pattern": "^feat-[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "enum": ["command", "display", "background", "event"]
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "surface_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^surface-[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^obj-[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "contract_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^contract-[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "flow_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^flow-[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "spec_id": {
          "type": "string",
          "pattern": "^spec-[a-z][a-z0-9_-]*$"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        }
      },
      "required": [
        "id",
        "title",
        "feature_id",
        "kind",
        "trigger",
        "surface_ids",
        "object_ids",
        "contract_ids",
        "flow_ids",
        "spec_id",
        "lifecycle"
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^contract-[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.(md|toml)$"
        },
        "object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^obj-[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "interaction_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^int-[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        }
      },
      "required": ["id", "title", "path", "object_ids", "interaction_ids", "lifecycle"]
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^flow-[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.(md|toml)$"
        },
        "contract_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^contract-[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "interaction_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^int-[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        }
      },
      "required": ["id", "title", "path", "contract_ids", "interaction_ids", "lifecycle"]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^spec-[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.(md|toml)$"
        },
        "interaction_id": {
          "type": "string",
          "pattern": "^int-[a-z][a-z0-9_-]*$"
        },
        "contract_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^contract-[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "flow_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^flow-[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^AC-[0-9]+$"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "enum": ["not_run", "passed", "failed"]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": ["id", "statement", "verification", "evidence_refs"]
          }
        }
      },
      "required": [
        "id",
        "title",
        "path",
        "interaction_id",
        "contract_ids",
        "flow_ids",
        "acceptance_criteria"
      ]
    },
    "external_link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "enum": ["github", "linear"]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "kind": {
          "enum": ["issue", "pull_request"]
        },
        "sync": {
          "const": "reference_only"
        }
      },
      "required": ["entity_id", "provider", "url", "kind", "sync"]
    }
  }
}
