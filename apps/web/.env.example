# Copy to apps/web/.env.local (ignored by Git). Never commit real values.

# GitHub App: read-only repository access. Required for /repositories.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Path to the App's private key, kept outside the repository (chmod 600).
GITHUB_APP_PRIVATE_KEY_PATH=
# Optional: GitHub Enterprise Server API or a local test double.
# GITHUB_API_URL=

# Accounts: set all three to require "Sign in with GitHub" and keep check history.
# Leave all three empty for single-operator mode on a local machine.
# Local Postgres from `pnpm db:up`:
DATABASE_URL=
# DATABASE_URL=postgres://spectrum:spectrum@127.0.0.1:54329/spectrum
# The App's Client ID and a client secret generated on its settings page.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Public origin when the server runs behind a proxy; the OAuth callback is built from it.
# SPECTRUM_PUBLIC_URL=https://spectrum.example.com
