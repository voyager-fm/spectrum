{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/voyager-fm/spectrum/main/packages/spec-engine/schemas/engineering.schema.json",
  "title": "Engineering knowledge metadata",
  "type": "object",
  "required": ["doc_type", "status"],
  "properties": {
    "doc_type": {
      "enum": ["topology", "implementation", "boundary", "runbook", "governance", "adr"]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "implementation_state": {
      "enum": ["current", "target", "mixed", "historical"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "doc_type": {
            "const": "adr"
          }
        }
      },
      "then": {},
      "else": {
        "required": ["implementation_state"]
      }
    }
  ],
  "$comment": "Sources and Verification prose own evidence. No source_refs metadata is required."
}
