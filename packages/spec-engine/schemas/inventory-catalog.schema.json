{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/voyager-fm/spectrum/main/packages/spec-engine/schemas/inventory-catalog.schema.json",
  "title": "Domain inventory catalog",
  "description": "One schema.json per domain directory. Each table names its TSV file relative to this catalog. Engine-owned FI tables extend a spectrum:* base schema and list base columns by name only; other tables carry a complete definition and a kind.",
  "type": "object",
  "required": ["schema_version", "tables"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "description": "A table extending an engine-owned base schema. The table key must equal the base table name.",
            "required": ["data", "extends", "columns"],
            "properties": {
              "data": {
                "$ref": "#/$defs/data"
              },
              "kind": {
                "enum": ["categories", "features", "interactions"]
              },
              "extends": {
                "enum": [
                  "spectrum:feature_categories",
                  "spectrum:features",
                  "spectrum:interactions"
                ]
              },
              "description": {
                "type": "string"
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": ["name"],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "$ref": "inventory.schema.json#/properties/columns/items"
                    }
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "A complete table definition. The table key is the table name.",
            "required": ["data", "kind", "primary_key", "columns"],
            "properties": {
              "data": {
                "$ref": "#/$defs/data"
              },
              "kind": {
                "enum": [
                  "objects",
                  "surfaces",
                  "regions",
                  "menus",
                  "categories",
                  "features",
                  "interactions",
                  "routes",
                  "other"
                ]
              },
              "description": {
                "type": "string"
              },
              "primary_key": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "null_values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "inventory.schema.json#/properties/columns/items"
                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "data": {
      "type": "string",
      "minLength": 1,
      "description": "TSV path relative to this catalog file."
    }
  }
}
