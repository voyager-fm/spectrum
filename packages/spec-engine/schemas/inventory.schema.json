{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/voyager-fm/spectrum/main/packages/spec-engine/schemas/inventory.schema.json",
  "title": "Standalone TSV table schema",
  "type": "object",
  "required": ["schema_version", "name", "primary_key", "columns"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "primary_key": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "null_values": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "required"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": ["string", "number", "boolean"]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "enum": {
            "type": "array",
            "items": {
              "type": ["string", "number", "boolean"]
            }
          },
          "ref": {
            "type": "object",
            "required": ["table"],
            "properties": {
              "table": {
                "type": "string",
                "minLength": 1
              },
              "column": {
                "type": "string",
                "minLength": 1
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "oneOf": [
              {
                "required": ["column"],
                "not": {
                  "anyOf": [
                    {
                      "required": ["columns"]
                    },
                    {
                      "required": ["references"]
                    }
                  ]
                }
              },
              {
                "required": ["columns", "references"],
                "not": {
                  "required": ["column"]
                }
              }
            ],
            "additionalProperties": false
          }
        }
      }
    }
  }
}
